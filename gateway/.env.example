# Porta da API Stateless
PORT=8787
GATEWAY_PUBLIC_URL=http://localhost:8787

# Origens permitidas (em produção restrinja para o domínio/capacitor://localhost)
ALLOWED_ORIGINS=*

# Lista opcional de hosts corporativos com certificado TLS autoassinado (separados por vírgula)
TLS_TRUSTED_HOSTS=

# Push Notifications (FCM HTTP v1 ou Webhook)
FCM_PROJECT_ID=
FCM_ACCESS_TOKEN=
PUSH_DISPATCH_WEBHOOK_URL=
PUSH_DISPATCH_AUTH_HEADER=

# OAuth 2.0 — Google (Gmail)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# OAuth 2.0 — Microsoft (Outlook / Office 365)
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
